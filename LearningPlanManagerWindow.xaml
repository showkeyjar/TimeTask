<Window x:Class="TimeTask.LearningPlanManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:TimeTask"
        mc:Ignorable="d"
        Title="{loc:Loc Lpm_WindowTitle}" Height="650" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E3F2FD" Padding="15" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Name="SubjectTextBlock" Text="{loc:Loc SetLearningPlan_LabelSubject}" FontSize="20" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock Name="GoalTextBlock" Text="{loc:Loc SetLearningPlan_LabelGoal}" FontSize="14" Foreground="#424242" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock Name="DurationTextBlock" Text="{loc:Loc SetLearningPlan_LabelDuration}" FontSize="12" Foreground="#757575" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{loc:Loc Lpm_CompletedProgress}" FontSize="12" Foreground="#757575" HorizontalAlignment="Center"/>
                    <TextBlock Name="ProgressTextBlock" Text="0%" FontSize="28" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    <TextBlock Name="ProgressDetailTextBlock" Text="{loc:Loc Lpm_StagesInitial}" FontSize="11" Foreground="#757575" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" Name="ProgressBar" Height="8" Margin="0,0,0,10" Minimum="0" Maximum="100" Value="0" Foreground="#4CAF50"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc Lpm_Milestones}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Name="MilestoneCountTextBlock" Text="{loc:Loc Lpm_MilestoneCountZero}" FontSize="12" Foreground="#757575" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="3" Name="MilestonesDataGrid" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" 
                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Lpm_ColumnStage}" Binding="{Binding StageNumber}" Width="60"/>
                <DataGridTextColumn Header="{loc:Loc Lpm_ColumnStageName}" Binding="{Binding StageName}" Width="*"/>
                <DataGridTextColumn Header="{loc:Loc Lpm_ColumnDescription}" Binding="{Binding Description}" Width="200"/>
                <DataGridTextColumn Header="{loc:Loc Lpm_ColumnTargetDate}" Binding="{Binding TargetDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridCheckBoxColumn Header="{loc:Loc Lpm_ColumnIsCompleted}" Binding="{Binding IsCompleted}" Width="70"/>
                <DataGridTextColumn Header="{loc:Loc Lpm_ColumnCompletedDate}" Binding="{Binding CompletedDate, StringFormat=yyyy-MM-dd}" Width="100"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                            <Setter Property="Background" Value="#E8F5E9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="False">
                            <Setter Property="Background" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,10">
            <Button Name="ActivateButton" Content="{loc:Loc Lpm_ButtonActivate}" Width="120" Height="30" Margin="0,0,10,0" Click="ActivateButton_Click"/>
            <Button Name="MarkCompleteButton" Content="{loc:Loc Lpm_ButtonMarkComplete}" Width="120" Height="30" Margin="0,0,10,0" Click="MarkCompleteButton_Click"/>
            <Button Name="DeleteButton" Content="{loc:Loc Lpm_ButtonDelete}" Width="100" Height="30" Margin="0,0,10,0" Click="DeleteButton_Click"/>
            <Button Name="CloseButton" Content="{loc:Loc Button_Close}" Width="80" Height="30" Click="CloseButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Name="StatusTextBlock" Text="{loc:Loc Lpm_StatusHint}" 
                   Foreground="#757575" FontSize="11" FontStyle="Italic" HorizontalAlignment="Left"/>
    </Grid>
</Window>
