<Window x:Class="TimeTask.ActionInboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="行动收件箱 · Action Inbox"
        Height="720" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Text="交流记录 · 行动收件箱"/>
            <TextBlock x:Name="MetaText" Foreground="#666" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 音频回放面板：无 ASR 时也能听回录音，不浪费 -->
        <Border x:Name="AudioPanel" Grid.Row="1" Margin="0,8,0,4" Padding="10,8"
                Background="#EAF3FB" BorderBrush="#BBD7F0" BorderThickness="1" CornerRadius="4"
                Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">录音回放</TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnPlayMic" Content="▶ 播放麦克风" Width="120" Height="30" Margin="0,0,8,0" Click="BtnPlayMic_Click"/>
                    <Button x:Name="BtnPlaySystem" Content="▶ 播放系统音频" Width="130" Height="30" Margin="0,0,8,0" Click="BtnPlaySystem_Click"/>
                    <Button x:Name="BtnStopPlay" Content="■ 停止" Width="80" Height="30" Margin="0,0,8,0" Click="BtnStopPlay_Click" IsEnabled="False"/>
                    <Button x:Name="BtnOpenFolder" Content="打开文件夹" Width="96" Height="30" Click="BtnOpenFolder_Click"/>
                </StackPanel>
                <TextBlock x:Name="PlayStatus" Foreground="#555" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 会议要点（会议助手实时提炼的结构化纪要） -->
        <Expander Grid.Row="2" Header="会议要点（实时提炼：新概念 / 待讨论 / 决策 / 行动项）" Margin="0,4,0,4" IsExpanded="True">
            <StackPanel>
                <TextBlock x:Name="MinutesSummary" FontSize="12" TextWrapping="Wrap" Foreground="#444" Margin="0,2,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="💡 新概念" FontWeight="SemiBold" Foreground="#0B6E8F" Margin="0,0,0,3"/>
                        <ItemsControl x:Name="MinConcepts">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Term}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Explanation}" FontSize="10" Foreground="#666" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="❓ 待讨论" FontWeight="SemiBold" Foreground="#0B6E8F" Margin="0,0,0,3"/>
                        <ItemsControl x:Name="MinQuestions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
                                        <TextBlock.Text>
                                            <Binding Path="Question"/>
                                        </TextBlock.Text>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Resolved}" Value="True">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="✅ 决策" FontWeight="SemiBold" Foreground="#0B6E8F" Margin="0,0,0,3"/>
                        <ItemsControl x:Name="MinDecisions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="📌 行动项" FontWeight="SemiBold" Foreground="#0B6E8F" Margin="0,0,0,3"/>
                        <ItemsControl x:Name="MinActions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Expander>

        <Expander Grid.Row="3" Header="转写摘要 / 原文" Margin="0,4,0,4" IsExpanded="True">
            <StackPanel>
                <TextBox x:Name="TranscriptBox" Height="120" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="12" Background="#F7F7F7" Margin="0,4,0,4"/>
                <!-- 无 ASR / 无文本时的手动转写兜底：完全离线、不依赖任何模型 -->
                <Expander x:Name="ManualExpander" Header="没有自动转写？手动录入文本并抽取行动项" Margin="0,4,0,0" IsExpanded="False">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
                            回放上方录音后，把听到的话逐句粘贴/输入到这里（每行一句或贴一整段均可），点击“提取行动项”即可走完整闭环，与自动转写完全等价。
                        </TextBlock>
                        <TextBox x:Name="ManualTextBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="BtnExtractFromText" Content="从文本提取行动项" Width="150" Height="32" Click="BtnExtractFromText_Click" Background="#1565C0" Foreground="White"/>
                            <Button x:Name="BtnClearManual" Content="清空" Width="70" Height="32" Margin="8,0,0,0" Click="BtnClearManual_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Expander>

        <DataGrid x:Name="Grid" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" Margin="0,4,0,4" SelectionMode="Single"
                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="#DDD">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="接受" Binding="{Binding Accepted, Mode=TwoWay}" Width="50"/>
                <DataGridTextColumn Header="行动项" Binding="{Binding Text, Mode=TwoWay}" Width="*"/>
                <DataGridComboBoxColumn x:Name="QuadrantColumn" Header="象限" SelectedItemBinding="{Binding Quadrant, Mode=TwoWay}" Width="120"/>
                <DataGridTemplateColumn Header="提醒日期" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding Reminder, Mode=TwoWay}" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceDisplay}" IsReadOnly="True" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="BtnAcceptAll" Content="全部接受" Width="96" Height="32" Margin="0,0,8,0" Click="BtnAcceptAll_Click" Background="#2E7D32" Foreground="White"/>
            <Button x:Name="BtnAcceptSelected" Content="接受选中" Width="96" Height="32" Margin="0,0,8,0" Click="BtnAcceptSelected_Click"/>
            <Button x:Name="BtnDismiss" Content="忽略" Width="80" Height="32" Click="BtnDismiss_Click"/>
        </StackPanel>
    </Grid>
</Window>
