<Window x:Class="TimeTask.ActionInboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TimeTask"
        Title="{loc:Loc ActionInbox_WindowTitle}"
        Height="600" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <!--
      设计原则（用户反馈：太繁琐 / 概念不懂 / 不知道下一步干嘛）：
      1) 首屏只回答一件事——「找到了几件事，加不加进任务列表」，一个绿色主按钮收口；
      2) 全部高级内容（回放、转写全文、会议纪要）默认折叠，用大白话命名；
      3) 不出现 ASR / LLM / 置信度 / 象限这类术语，列头改成「加入 / 事项 / 放到哪 / 提醒我」。
    -->
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. 一句话结论 -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock x:Name="TitleText" FontSize="19" FontWeight="Bold" Text="{loc:Loc ActionInbox_TitleDefault}"/>
            <TextBlock x:Name="MetaText" Foreground="#666" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 1. 操作引导（有人话的下一步） -->
        <TextBlock x:Name="ActionHintText" Grid.Row="1" Margin="0,10,0,4" FontSize="13" Foreground="#333"
                   Text="{loc:Loc ActionInbox_Hint}"/>

        <!-- 2. 行动项卡片 / 空态卡片 -->
        <Border x:Name="ActionsCard" Grid.Row="2" Background="#FDFEFD" BorderBrush="#D8E4D8"
                BorderThickness="1" CornerRadius="6" Padding="6" ClipToBounds="True">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent"
                      HeadersVisibility="Column" BorderThickness="0" RowHeight="34"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{loc:Loc ActionInbox_ColumnAccept}" Binding="{Binding Accepted, Mode=TwoWay}" Width="46"/>
                    <DataGridTextColumn Header="{loc:Loc ActionInbox_ColumnItem}" Binding="{Binding Text, Mode=TwoWay}" Width="*"/>
                    <DataGridComboBoxColumn x:Name="QuadrantColumn" Header="{loc:Loc ActionInbox_ColumnQuadrant}"
                                            SelectedValueBinding="{Binding QuadrantIndex, Mode=TwoWay}"
                                            SelectedValuePath="Index" DisplayMemberPath="Name" Width="128"/>
                    <DataGridTemplateColumn Header="{loc:Loc ActionInbox_ColumnReminder}" Width="112">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding Reminder, Mode=TwoWay}" BorderThickness="0"
                                            ToolTip="{loc:Loc ActionInbox_ReminderTooltip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border x:Name="EmptyCard" Grid.Row="2" Background="#FBF9F2" BorderBrush="#E6DFC8"
                BorderThickness="1" CornerRadius="6" Padding="16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="EmptyReasonText" FontSize="13" TextWrapping="Wrap" Foreground="#5A5245" LineHeight="22"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnEmptyListen" Content="{loc:Loc ActionInbox_EmptyListen}" Width="120" Height="32" Margin="0,0,10,0"
                            Click="BtnEmptyListen_Click" Background="#FFFDF6" BorderBrush="#C9B98A"/>
                    <Button x:Name="BtnEmptyManual" Content="{loc:Loc ActionInbox_EmptyManual}" Width="140" Height="32"
                            Click="BtnEmptyManual_Click" Background="#FFFDF6" BorderBrush="#C9B98A"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. 主操作：一个绿色按钮收口 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnAcceptAll" Content="{loc:Loc ActionInbox_Accept}" Height="40" MinWidth="230" Padding="14,0"
                    Click="BtnAcceptAll_Click" Background="#2E7D32" Foreground="White" FontSize="14"
                    FontWeight="SemiBold" BorderBrush="#256428"/>
            <Button x:Name="BtnDismiss" Content="{loc:Loc ActionInbox_Dismiss}" Height="40" Margin="12,0,0,0" Padding="10,0"
                    Click="BtnDismiss_Click" Background="Transparent" Foreground="#777"
                    BorderThickness="0" FontSize="13"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 4. 折叠：听录音 / 找文件 -->
        <Expander x:Name="AudioExpander" Grid.Row="4" Header="{loc:Loc ActionInbox_AudioHeader}" Margin="0,12,0,0" IsExpanded="False">
            <Border Background="#F4FAFE" BorderBrush="#CFE3F2" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,6,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnPlayMic" Content="{loc:Loc ActionInbox_PlayMic}" Width="150" Height="30" Margin="0,0,8,0" Click="BtnPlayMic_Click"/>
                        <Button x:Name="BtnPlaySystem" Content="{loc:Loc ActionInbox_PlaySystem}" Width="130" Height="30" Margin="0,0,8,0" Click="BtnPlaySystem_Click"/>
                        <Button x:Name="BtnStopPlay" Content="{loc:Loc ActionInbox_StopPlay}" Width="76" Height="30" Margin="0,0,8,0" Click="BtnStopPlay_Click" IsEnabled="False"/>
                        <Button x:Name="BtnOpenFolder" Content="{loc:Loc ActionInbox_OpenFolder}" Width="96" Height="30" Click="BtnOpenFolder_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PlayStatus" Foreground="#555" FontSize="11" Margin="0,4,0,0"/>
                    <TextBlock x:Name="RetentionNote" Foreground="#999" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Expander>

        <!-- 5. 折叠：转写全文 + 手动补记兜底 -->
        <Expander x:Name="TranscriptExpander" Grid.Row="5" Header="{loc:Loc ActionInbox_TranscriptHeader}" Margin="0,8,0,0" IsExpanded="False">
            <StackPanel>
                <TextBox x:Name="TranscriptBox" Height="120" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="12" Background="#F7F7F7" Margin="0,6,0,4"/>
                <!-- 没能自动转成文字时的手动兜底：完全离线、不依赖任何模型 -->
                <Expander x:Name="ManualExpander" Header="{loc:Loc ActionInbox_ManualHeader}" Margin="0,2,0,0" IsExpanded="False">
                    <StackPanel Margin="0,6,0,0">
                        <TextBox x:Name="ManualTextBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="BtnExtractFromText" Content="{loc:Loc ActionInbox_ExtractFromText}" Width="150" Height="32" Click="BtnExtractFromText_Click" Background="#1565C0" Foreground="White"/>
                            <Button x:Name="BtnClearManual" Content="{loc:Loc ActionInbox_ClearManual}" Width="70" Height="32" Margin="8,0,0,0" Click="BtnClearManual_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Expander>

        <!-- 6. 折叠：会议纪要 -->
        <Expander x:Name="MinutesExpander" Grid.Row="6" Header="{loc:Loc ActionInbox_MinutesHeader}" Margin="0,8,0,0" IsExpanded="False">
            <StackPanel>
                <TextBlock x:Name="MinutesSummary" FontSize="12" TextWrapping="Wrap" Foreground="#444" Margin="0,6,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc ActionInbox_MinConcepts}" FontWeight="SemiBold" Foreground="#0B6E8F" Margin="0,0,0,3"/>
                        <ItemsControl x:Name="MinConcepts">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Term}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Explanation}" FontSize="10" Foreground="#666" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc ActionInbox_MinQuestions}" FontWeight="SemiBold" Foreground="#0B6E8F" Margin="0,0,0,3"/>
                        <ItemsControl x:Name="MinQuestions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
                                        <TextBlock.Text>
                                            <Binding Path="Question"/>
                                        </TextBlock.Text>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Resolved}" Value="True">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc ActionInbox_MinDecisions}" FontWeight="SemiBold" Foreground="#0B6E8F" Margin="0,0,0,3"/>
                        <ItemsControl x:Name="MinDecisions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="{loc:Loc ActionInbox_MinActions}" FontWeight="SemiBold" Foreground="#0B6E8F" Margin="0,0,0,3"/>
                        <ItemsControl x:Name="MinActions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Expander>
    </Grid>
</Window>
